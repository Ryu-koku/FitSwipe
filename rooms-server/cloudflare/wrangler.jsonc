{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "fitswipe-rooms-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-05-25",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitswipe-rooms",
      "database_id": "851c476f-1937-4285-9ad9-6e78dbd05ecb",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "API_LIMIT",
      "namespace_id": "6271038241",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "REGISTER_LIMIT",
      "namespace_id": "6271038242",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}

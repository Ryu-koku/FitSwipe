{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "FITSWIPE_APP_VARIANT": "development",
        "EXPO_PUBLIC_ROOMS_URL": "https://fitswipe-rooms-api.prompt-tem.workers.dev"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "FITSWIPE_APP_VARIANT": "development",
        "EXPO_PUBLIC_ROOMS_URL": "https://fitswipe-rooms-api.prompt-tem.workers.dev"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}

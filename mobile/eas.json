{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "production-local-key": {
      "extends": "production",
      "environment": "production",
      "credentialsSource": "local"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
